rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /publicaciones/{document} {
      allow read: if true;
      allow create: if request.auth != null;
      // Solo permite cambiar el estado a 'Publicado en Redes' si el usuario tiene el custom claim 'admin'
      allow update: if request.auth != null && (
        !(request.resource.data.diff(resource.data).affectedKeys().hasAny(['estado']) && request.resource.data.estado == 'Publicado en Redes') 
        || request.auth.token.admin == true
      );
      allow delete: if request.auth != null;
    }
    
    // Regla por defecto para otras colecciones (si las hay)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
